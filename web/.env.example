# Exact public origin, no trailing slash. Used for the OG image and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google Sheets backend (see ../SETUP.md). Without these, signups are NOT saved on Vercel.
SHEETS_WEBAPP_URL=https://script.google.com/macros/s/XXXXXXXX/exec
SHEETS_SECRET=same-long-random-string-as-the-apps-script-SECRET-property

# Password for /admin (the funnel dashboard).
ADMIN_PASSWORD=change-me

# Optional. Meta Pixel ID (digits only) from Events Manager. Fires PageView, WaitlistIntent, Lead, CompleteRegistration.
NEXT_PUBLIC_META_PIXEL_ID=
